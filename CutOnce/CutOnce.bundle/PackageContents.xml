<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="CutOnce"
    AppVersion="2.1.0"
    Description="CutOnce for Civil 3D: data-loss guards, change-impact warnings, ByLayer, xref, label-override and coordinate system checks, bloat cleanup with backup copies, and drawing health logs, controlled per designer."
    Author="Stephen Walz"
    ProductCode="{BA953C42-1FDA-4A0D-8371-4C37CE1477B7}"
    UpgradeCode="{FD9441FE-9603-4169-8EFD-D9FDD76DD7B1}">

  <CompanyDetails Name="Stephen Walz" Url="" Email="" />

  <RuntimeRequirements OS="Win64" Platform="Civil3D" SeriesMin="R24.0" />

  <Components Description="CutOnce AutoLISP application">
    <RuntimeRequirements OS="Win64" Platform="Civil3D" SeriesMin="R24.0" />
    <ComponentEntry
        AppName="CutOnce"
        Version="2.1.0"
        ModuleName="./Contents/CutOnce-Loader.lsp"
        AppDescription="Loads CutOnce-Config.lsp and CutOnce.vlx into every drawing."
        LoadOnAutoCADStartup="True"
        PerDocument="True" />
  </Components>

  <!-- Optional .NET helper that detects typed-over label text (see
       dotnet/CutOnceLabels/README.md). One build per .NET generation; the
       installer removes the entry for a DLL that was not built. -->
  <Components Description="CutOnce label helper, Civil 3D 2021-2024">
    <RuntimeRequirements OS="Win64" Platform="Civil3D" SeriesMin="R24.0" SeriesMax="R24.3" />
    <ComponentEntry
        AppName="CutOnceLabels"
        Version="2.1.0"
        ModuleName="./Contents/net48/CutOnceLabels.dll"
        AppDescription="Lets CutOnce detect typed-over Civil 3D label text."
        LoadOnAutoCADStartup="True" />
  </Components>
  <Components Description="CutOnce label helper, Civil 3D 2025 and later">
    <RuntimeRequirements OS="Win64" Platform="Civil3D" SeriesMin="R25.0" />
    <ComponentEntry
        AppName="CutOnceLabels"
        Version="2.1.0"
        ModuleName="./Contents/net8/CutOnceLabels.dll"
        AppDescription="Lets CutOnce detect typed-over Civil 3D label text."
        LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
