<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build (see README.md in this folder):
      Civil 3D 2021-2024:  dotnet build -c Release -p:AcadDir="C:\Program Files\Autodesk\AutoCAD 2024"
      Civil 3D 2025+:      dotnet build -c Release -p:AcadDir="C:\Program Files\Autodesk\AutoCAD 2025" -p:TargetFramework=net8.0-windows
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CutOnceLabels</AssemblyName>
    <RootNamespace>CutOnce</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AcadDir>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.1.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="accoremgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
