<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner (no NuGet needed). Run: dotnet run, project tests/CutOnce.Core.Tests
    Exit code 0 = every test passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CutOnce.Core\CutOnce.Core.csproj" />
  </ItemGroup>

</Project>
