<ui:BrandedWindow x:Class="CutOnce.UI.ControlCenterWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:CutOnce.UI"
                  Width="1060">
    <DockPanel LastChildFill="True">

        <!-- Bottom bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" Style="{StaticResource CutOnce.Button}" Margin="8,0,0,0" Click="OnCancel" />
                <Button Content="Save" Style="{StaticResource CutOnce.PrimaryButton}" Margin="8,0,0,0" MinWidth="104"
                        IsDefault="True" Click="OnSave" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-8,0,0,0">
                <Button Style="{StaticResource CutOnce.LinkButton}" Click="OnDefaults">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reset to defaults" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CutOnce.LinkButton}" Click="OnLearnMore">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Learn More..." />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Note}" Style="{StaticResource CutOnce.Subtle}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="640">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Command warnings -->
                <Border Grid.Column="0" Style="{StaticResource CutOnce.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CutOnce.CardTitle}" Text="Command warnings" />
                        <ContentControl Content="{Binding CommandWarnings}" ContentTemplate="{StaticResource CutOnce.SettingRow}"
                                        FontWeight="SemiBold" IsTabStop="False" />

                        <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="HOW OFTEN" />
                        <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3" BorderThickness="1"
                                BorderBrush="{StaticResource CutOnce.Line}" Background="{StaticResource CutOnce.Canvas}"
                                IsEnabled="{Binding FrequencyEditable}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource CutOnce.Segment}" GroupName="CutOnceFrequency"
                                             IsChecked="{Binding FrequencyEvery}" Content="Every time" />
                                <RadioButton Style="{StaticResource CutOnce.Segment}" GroupName="CutOnceFrequency"
                                             IsChecked="{Binding FrequencyOnce}" Content="Once per command, per session" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="SHOW THE WARNING FOR" />
                        <ItemsControl ItemsSource="{Binding CommandItems}" ItemTemplate="{StaticResource CutOnce.SettingRow}"
                                      IsTabStop="False" />
                        <Button Style="{StaticResource CutOnce.LinkButton}" HorizontalAlignment="Left" Margin="-8,4,0,0"
                                Click="OnOtherHelp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="How to add other watched commands..." />
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="STOPPING A COMMAND" />
                        <ItemsControl ItemsSource="{Binding StopItems}" ItemTemplate="{StaticResource CutOnce.SettingRow}"
                                      IsTabStop="False" />
                        <TextBlock Style="{StaticResource CutOnce.Subtle}" Margin="46,2,0,0"
                                   Text="Warnings shown before a command runs offer Stop; warnings shown after it ran offer Undo." />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Checks on save -->
                    <Border Style="{StaticResource CutOnce.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CutOnce.CardTitle}" Text="Checks on save" />
                            <ContentControl Content="{Binding GuardGrowth}" ContentTemplate="{StaticResource CutOnce.SettingRow}"
                                            FontWeight="SemiBold" IsTabStop="False" />
                            <ItemsControl ItemsSource="{Binding SaveItems}" ItemTemplate="{StaticResource CutOnce.SettingRow}"
                                          IsTabStop="False" />
                            <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="BACKUP FOLDER" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CutOnce.Button}" Margin="8,0,0,0" Click="OnOpenBackups">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource CutOnce.PathBox}" Text="{Binding BackupFolder, Mode=OneWay}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Standards check on open -->
                    <Border Style="{StaticResource CutOnce.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CutOnce.CardTitle}" Text="Standards check when a drawing opens" />
                            <ContentControl Content="{Binding StdCheckOnOpen}" ContentTemplate="{StaticResource CutOnce.SettingRow}"
                                            FontWeight="SemiBold" IsTabStop="False" />
                            <ItemsControl ItemsSource="{Binding OpenItems}" ItemTemplate="{StaticResource CutOnce.SettingRow}"
                                          IsTabStop="False" />
                        </StackPanel>
                    </Border>

                    <!-- Logging -->
                    <Border Style="{StaticResource CutOnce.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CutOnce.CardTitle}" Text="Logging" />
                            <ContentControl Content="{Binding LogEnabled}" ContentTemplate="{StaticResource CutOnce.SettingRow}"
                                            FontWeight="SemiBold" IsTabStop="False" />
                            <ItemsControl ItemsSource="{Binding LogItems}" ItemTemplate="{StaticResource CutOnce.SettingRow}"
                                          IsTabStop="False" />
                            <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="LOG FOLDER" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CutOnce.Button}" Margin="8,0,0,0" Click="OnOpenLogs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource CutOnce.PathBox}" Text="{Binding LogFolder, Mode=OneWay}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</ui:BrandedWindow>
