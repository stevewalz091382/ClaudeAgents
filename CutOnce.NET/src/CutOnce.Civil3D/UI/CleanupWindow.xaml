<ui:BrandedWindow x:Class="CutOnce.UI.CleanupWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="clr-namespace:CutOnce.UI"
                  Width="760">
    <DockPanel LastChildFill="True">

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource CutOnce.LinkButton}" Margin="-8,0,0,0" Click="OnLearnMore">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Learn More..." />
                </StackPanel>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource CutOnce.Button}" Margin="8,0,0,0" Click="OnCancel" />
                <Button Style="{StaticResource CutOnce.PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnCleanUp">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource CutOnce.IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Clean up" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <StackPanel>
            <!-- What cleanup means -->
            <Border Style="{StaticResource CutOnce.SoftCard}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource CutOnce.IconFont}" FontSize="16"
                               Foreground="{DynamicResource CutOnce.Brand}" Margin="2,2,12,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Cleanup changes this drawing. PURGE removes only items nothing in the drawing uses, and AUDIT fixes errors. Everything runs as one undo step, so U straight afterwards undoes it all. Save the drawing afterwards to keep the result." />
                        <TextBox Style="{StaticResource CutOnce.PathBox}" Margin="0,8,0,0" Text="{Binding DrawingPath, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="REMOVE (ONLY ITEMS NOTHING USES), IN THIS ORDER" />
            <Border Style="{StaticResource CutOnce.Card}" Padding="16,10">
                <ItemsControl ItemsSource="{Binding Steps}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5">
                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Background="{DynamicResource CutOnce.BrandSoft}"
                                        Visibility="{Binding HasCount, Converter={StaticResource CutOnce.BoolToVis}}">
                                    <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CutOnce.BrandDark}" />
                                </Border>
                                <CheckBox Style="{StaticResource CutOnce.Check}" IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource CutOnce.Eyebrow}" Text="BACKUP COPY" />
            <Border Style="{StaticResource CutOnce.Card}" Padding="16,12">
                <StackPanel>
                    <CheckBox Style="{StaticResource CutOnce.Check}" IsChecked="{Binding Backup}" IsEnabled="{Binding BackupEditable}"
                              FontWeight="SemiBold" Content="Save a backup copy to the shared backup folder first (recommended)" />
                    <TextBox Style="{StaticResource CutOnce.PathBox}" Margin="28,8,0,0" Text="{Binding BackupFolder, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CutOnce.Subtle}" Margin="28,6,0,0" Text="{Binding BackupNote}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</ui:BrandedWindow>
